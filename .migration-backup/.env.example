# Frontend (Vercel)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend (Fly.io / Replit)
PORT=8080
NODE_ENV=production

# Clerk (backend)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Database (Neon / PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Supabase Storage (for temporary video hosting outside Replit)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=videos

# Optional: set to skip Replit Object Storage and use Supabase Storage
USE_SUPABASE_STORAGE=true

# Platform OAuth credentials (required for real publishing later)
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...
INSTAGRAM_CLIENT_ID=...
INSTAGRAM_CLIENT_SECRET=...
TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...

# Replit-only (ignore outside Replit)
REPLIT_DEV_DOMAIN=...
