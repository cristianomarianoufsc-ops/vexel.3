{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "PORT=3000 BASE_PATH=/ sh -c 'cd artifacts/vexelhub && pnpm run build'",
  "outputDirectory": "artifacts/vexelhub/dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://vexelhub-api.fly.dev/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}